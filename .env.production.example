# Template deployment. Isi secret di server, jangan commit .env hasilnya.
APP_NAME=NusaLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nusalens.example.com
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
INERTIA_SSR_ENABLED=false

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nusalens
DB_USERNAME=nusalens
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=nusalens_production
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=nusalens_production_database_
REDIS_QUEUE_RETRY_AFTER=120

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SECTORS_API_BASE_URL=https://api.sectors.app/v2
SECTORS_API_KEY=
SECTORS_API_TIMEOUT=10
SECTORS_CREDIT_GLOBAL_BUDGET=1000
SECTORS_CREDIT_DAILY_USER_QUOTA=20
SECTORS_CREDIT_MAX_ATTEMPTS=2
SECTORS_CREDIT_TIMEZONE=Asia/Jakarta
MARKETDATA_PROVIDER_MODE=real
MARKETDATA_MAPPING_VERSION=v1
MARKETDATA_CACHE_PREFIX=marketdata
VITE_APP_NAME="${APP_NAME}"
